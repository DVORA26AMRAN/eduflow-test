VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Edge Function clever-processor (Auth invite redirect). Set as a Function secret:
#   supabase secrets set APP_URL=https://your-production-host
# Local example (must also be allow-listed in Supabase Auth redirect URLs):
#   APP_URL=http://127.0.0.1:5173
# APP_URL=
# EDUFLOW_APP_URL=
# SITE_URL=

# Substitute Board email dispatcher (N1/N1B) — Edge Function substitute-board-email-dispatcher.
# Cron/backend + service_role only. Never put these in VITE_* frontend env:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set SUBSTITUTE_BOARD_SENDER_EMAIL=notifications@your-verified-domain.com
#   supabase secrets set APP_URL=https://mpex.school
# Production APP_URL must be https://mpex.school (not localhost).
# Sender: Resend-accepted From string — raw email OR "Display Name <email@domain>"
#   (must use a domain/address verified in Resend). Do not reuse QUOTATION_SENDER_EMAIL.
# N1 CTA: {APP_URL}/?section=substituteBoard (exact post deep-link is N2).
# Scheduler (N1B): pg_cron → Vault CRON_SERVICE_ROLE_KEY + PROJECT_PUBLISHABLE_KEY
#   → substitute-board-email-dispatcher once per minute (* * * * *).
# SUBSTITUTE_BOARD_SENDER_EMAIL=

# Optional: database-level RLS verification (scripts/verify-manager-archive-rls.mjs)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# VERIFY_MANAGER_A_EMAIL=
# VERIFY_MANAGER_A_PASSWORD=
# VERIFY_MANAGER_B_EMAIL=
# VERIFY_MANAGER_B_PASSWORD=
# VERIFY_TEACHER_EMAIL=
# VERIFY_TEACHER_PASSWORD=
# VERIFY_SECRETARY_EMAIL=
# VERIFY_SECRETARY_PASSWORD=
# VERIFY_STUDENT_EMAIL=
# VERIFY_STUDENT_PASSWORD=
